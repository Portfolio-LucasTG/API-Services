# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL
POSTGRES_USER=iris
POSTGRES_PASSWORD=iris
POSTGRES_DB=iris

# --- Used by seeder and api (host "db" = the Compose service)
DATABASE_URL=postgresql+psycopg://iris:iris@db:5432/iris
LOG_LEVEL=INFO

# --- Seeder
KAGGLE_DATASET=uciml/iris
# Set to use a local CSV instead of downloading (path inside the container)
DATASET_PATH=
# Use seeder/data/Iris.csv when the Kaggle download fails
SEED_ALLOW_FALLBACK=true
# Only needed if Kaggle asks for authentication
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- Published ports on the host
DB_PORT=5432
API_PORT=5000
FRONTEND_PORT=8080
